{
  "manifest_version": 3,
  "name": "Timereal",
  "version": "0.6.0",
  "description": "Persönliche Zeiterfassung direkt in der Browserleiste.",
  "key": "",
  "permissions": ["storage", "identity"],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "einstellungen.html",
  "background": {
    "service_worker": "hintergrund.js",
    "type": "module"
  }
}
