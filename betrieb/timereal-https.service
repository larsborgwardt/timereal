[Unit]
Description=Timereal HTTPS im Testnetz
After=network-online.target timereal.service
Wants=network-online.target

[Service]
User=timereal_proxy
Group=timereal_proxy
StateDirectory=timereal-https
StateDirectoryMode=0700
UMask=0077
Environment=XDG_DATA_HOME=/var/lib/timereal-https
Environment=XDG_CONFIG_HOME=/var/lib/timereal-https
ExecStart=/usr/bin/caddy run --config /etc/timereal/Caddyfile --adapter caddyfile
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
