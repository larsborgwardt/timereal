[Unit]
Description=Timereal verschlüsselt extern sichern
After=postgresql.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/timereal/extern/password

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/timereal-current/betrieb/extern-sichern.sh sichern
UMask=0077
NoNewPrivileges=true
